<Window x:Class="EcowittWeather.Desktop.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecowitt Weather – Nastavenia"
        Icon="pack://application:,,,/Assets/EcowittWeather.ico"
        Width="640" Height="740" MinWidth="555" MinHeight="585"
        WindowStartupLocation="CenterScreen" Background="#FF141D2A"
        Foreground="#FFF5F8FC" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FF85D1F0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFBFCFDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFF1F7FF"/>
            <Setter Property="Background" Value="#FF27384D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="{TemplateBinding Background}"
                                CornerRadius="5,5,0,0"
                                BorderBrush="#FF445A72" BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#FF2C6681"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#FF7BC7E4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18" LastChildFill="True">
        <Border DockPanel.Dock="Top" BorderBrush="#FF425A74"
                BorderThickness="0,0,0,1" Padding="0,0,0,13" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="ECOWITT WEATHER" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Desktop Edition · Správa meteostaníc"
                               Foreground="#FFBDCCDA" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="Pomoc a návod ↗" Click="GuideClick"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#FF425A74"
                BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Zmeny sa použijú až po uložení."
                           Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Zrušiť" Width="100" Click="CancelClick"/>
                    <Button Content="Uložiť nastavenia" Width="165" IsDefault="True"
                            Style="{StaticResource PrimaryActionButton}" Click="SaveClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Name="SettingsTabs" Background="#FF192635"
                    BorderBrush="#FF425A74" BorderThickness="1"
                    Foreground="White" Padding="0" SelectedIndex="0">
            <TabItem Header="Začíname">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,20,18,18">
                        <TextBlock Text="Vitaj v Ecowitt Weather!" FontWeight="Bold"
                                   FontSize="19" Margin="0,0,0,12"/>
                        <TextBlock Text="Pripojenie stanice zvládneš v troch krokoch."
                                   Style="{StaticResource Hint}" Margin="0,0,0,20"/>
                        <Border Background="#FF20334A" CornerRadius="8"
                                Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="1  Vyber spôsob pripojenia"
                                           FontWeight="Bold" FontSize="15"
                                           Margin="0,0,0,7"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Web API: používa Ecowitt účet a funguje aj mimo domu. Local API: priame spojenie s gatewayom v sieti, bez kľúčov. Auto: Local API so zálohou cez Web."/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF20334A" CornerRadius="8"
                                Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="2  Pripoj svoju meteostanicu"
                                           FontWeight="Bold" FontSize="15"
                                           Margin="0,0,0,7"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Pri Web API vytvor na ecowitt.net Application Key a API Key, potom klikni na Načítať stanice. Pri Local API stačí IP adresa gatewaya."/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Otvoriť ecowitt.net ↗" Click="EcowittClick"/>
                                    <Button Content="Kde nájdem API kľúče? ↗" Click="GuideClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF20334A" CornerRadius="8"
                                Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="3  Otestuj spojenie a ulož"
                                           FontWeight="Bold" FontSize="15"
                                           Margin="0,0,0,7"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="V časti Pripojenie otestuj merania. Potom klikni na Uložiť nastavenia. Widget zobrazí počasie a ďalšie stanice môžeš pridať neskôr."/>
                            </StackPanel>
                        </Border>
                        <Button Content="Prejsť na pripojenie →"
                                HorizontalAlignment="Left" Width="216"
                                Style="{StaticResource PrimaryActionButton}"
                                Click="StartSetupClick"/>
                        <TextBlock Text="Heslo do Ecowitt účtu aplikácia nikdy nevyžaduje."
                                   Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Stanice">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,20,18,18">
                        <TextBlock Text="TVOJE STANICE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Môžeš pridať viac profilov a každému widgetu priradiť inú meteostanicu."
                                   Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Name="ProfileCombo" VerticalAlignment="Center"
                                      Style="{StaticResource DarkStationCombo}"
                                      ItemContainerStyle="{StaticResource DarkStationComboItem}"
                                      SelectionChanged="ProfileSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                   FontSize="13" Margin="5,3"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="+ Pridať" Click="AddProfileClick"/>
                            <Button Grid.Column="2" Content="Odstrániť" Click="RemoveProfileClick"/>
                        </Grid>
                        <TextBlock Text="Názov meteostanice" Style="{StaticResource FormLabel}"/>
                        <TextBox Name="ProfileNameBox" Margin="0,0,0,13"
                                 LostFocus="ProfileNameLostFocus"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                                   Text="Tento názov sa zobrazí v hlavičke widgetu. Môžeš použiť napríklad Dom, Chata alebo Kancelária."/>
                        <Button Content="Nastaviť pripojenie tejto stanice →"
                                HorizontalAlignment="Left" Click="StartSetupClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Pripojenie">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,20,18,18">
                        <TextBlock Text="AKO ZÍSKAVAŤ MERANIA?" Style="{StaticResource SectionTitle}"/>
                        <ComboBox Name="SourceModeCombo" MinHeight="38"
                                  Style="{StaticResource DarkStationCombo}"
                                  ItemContainerStyle="{StaticResource DarkStationComboItem}"
                                  DisplayMemberPath="Label"
                                  SelectionChanged="SourceModeSelectionChanged"
                                  Margin="0,0,0,9"/>
                        <TextBlock Name="SourceModeDescription" Style="{StaticResource Hint}"
                                   Margin="0,0,0,17"/>
                        <StackPanel Name="LocalGatewayPanel" Margin="0,0,0,16">
                            <Border BorderBrush="#FF466077" BorderThickness="0,1,0,0"
                                    Margin="0,0,0,14"/>
                            <TextBlock Text="LOKÁLNA SIEŤ" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="IP adresa alebo názov gatewaya"
                                       Style="{StaticResource FormLabel}"/>
                            <TextBox Name="LocalGatewayBox" Margin="0,0,0,7"/>
                            <TextBlock Text="Príklad: 192.168.1.100 alebo gw3000.local:80. Počítač musí byť v rovnakej sieti alebo VPN."
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Name="CloudFieldsPanel">
                            <Border BorderBrush="#FF466077" BorderThickness="0,1,0,0"
                                    Margin="0,0,0,14"/>
                            <TextBlock Text="ECOWITT WEB API" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Kľúče si vytvoríš vo svojom používateľskom profile na ecowitt.net. Heslo do účtu sem nezadávaj."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Vytvoriť API kľúče ↗" Click="EcowittClick"/>
                                <Button Content="Zobraziť návod ↗" Click="GuideClick"/>
                            </StackPanel>
                            <TextBlock Text="Application Key" Style="{StaticResource FormLabel}"/>
                            <PasswordBox Name="ApplicationKeyBox" Margin="0,0,0,12"/>
                            <TextBlock Text="API Key" Style="{StaticResource FormLabel}"/>
                            <PasswordBox Name="ApiKeyBox" Margin="0,0,0,16"/>
                            <Border Background="#FF1E2B3A" CornerRadius="7"
                                    BorderBrush="#FF465F79" BorderThickness="1"
                                    Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="VÝBER METEOSTANICE Z ÚČTU"
                                               FontSize="13" FontWeight="Bold" Margin="0,0,0,7"/>
                                    <TextBlock Text="Nemusíš ručne prepisovať MAC. Načítaj zoznam zariadení priradených k účtu."
                                               Style="{StaticResource Hint}" Margin="0,0,0,9"/>
                                    <Button Name="LoadDevicesButton"
                                            Content="Načítať stanice z Ecowitt"
                                            HorizontalAlignment="Left" Margin="0,0,0,9"
                                            Click="LoadDevicesClick"/>
                                    <ComboBox Name="StationCombo" MinHeight="37"
                                              Style="{StaticResource DarkStationCombo}"
                                              ItemContainerStyle="{StaticResource DarkStationComboItem}"
                                              IsEnabled="False" Margin="0,0,0,8"
                                              SelectionChanged="DeviceSelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" Foreground="White"
                                                           FontSize="12" Margin="5,3"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Name="DeviceStatus"
                                               Text="Stanice načítaš po vyplnení oboch API kľúčov."
                                               Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="MAC adresa meteostanice (možno zadať ručne)"
                                       Style="{StaticResource FormLabel}"/>
                            <TextBox Name="MacBox" Margin="0,0,0,14"/>
                        </StackPanel>
                        <Border BorderBrush="#FF466077" BorderThickness="0,1,0,0"
                                Margin="0,0,0,12"/>
                        <Button Name="TestConnectionButton" Content="Otestovať pripojenie"
                                HorizontalAlignment="Left" Width="200" Click="TestConnectionClick"/>
                        <TextBlock Name="ConnectionTestStatus" Text="Test preverí zvolený zdroj bez uloženia nastavení."
                                   Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Senzory">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,20,18,18">
                        <TextBlock Text="NÁZVY SENZOROV CH1–CH8"
                                   Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Voliteľné pomenovanie kanálov pre vybraný profil. Prázdne pole použije CH1, CH2 a podobne."
                                   Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                        <StackPanel Name="AliasPanel" Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Aplikácia">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,20,18,18">
                        <TextBlock Text="OBNOVOVANIE ÚDAJOV" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Interval načítania v sekundách (30–3600)"
                                   Style="{StaticResource FormLabel}"/>
                        <TextBox Name="RefreshSecondsBox" Width="125"
                                 HorizontalAlignment="Left" Margin="0,0,0,11"/>
                        <TextBlock Text="Rovnakú stanicu aplikácia načíta iba raz, aj keď sa zobrazuje vo viacerých widgetoch."
                                   Style="{StaticResource Hint}" Margin="0,0,0,20"/>
                        <TextBlock Text="POMOC A INFORMÁCIE" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Aktualizácie" Click="UpdatesClick"/>
                            <Button Content="O programe" Click="AboutClick"/>
                        </StackPanel>
                        <Button Content="Návod na nastavenie ↗"
                                HorizontalAlignment="Left" Click="GuideClick"/>
                        <Border BorderBrush="#FF466077" BorderThickness="0,1,0,0"
                                Margin="0,20,0,12"/>
                        <TextBlock Text="OCHRANA PRIHLASOVACÍCH ÚDAJOV"
                                   Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Aplikácia nikdy nežiada heslo Ecowitt účtu. API kľúče sa ukladajú oddelene do súboru chráneného Windows DPAPI pre aktuálne konto."
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
