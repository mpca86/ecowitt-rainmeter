<Window x:Class="EcowittWeather.Desktop.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecowitt Weather – Nastavenia"
        Width="490" Height="700" MinWidth="440" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#FF161E29"
        Foreground="#FFE8EDF5">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Zrušiť" Width="94" Click="CancelClick"/>
            <Button Content="Uložiť" Width="105" IsDefault="True"
                    Click="SaveClick"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ECOWITT WEATHER" FontSize="17"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Desktop Edition · prvý Cloud API prototyp"
                           Foreground="#FFA5B4C3" Margin="0,0,0,14"/>
                <TextBlock Text="Stanica" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,7"/>
                <TextBlock Text="Názov profilu" Margin="0,0,0,4"/>
                <TextBox Name="ProfileNameBox" Padding="6" Margin="0,0,0,10"/>
                <TextBlock Text="MAC adresa stanice" Margin="0,0,0,4"/>
                <TextBox Name="MacBox" Padding="6" Margin="0,0,0,10"/>
                <TextBlock Text="Application Key" Margin="0,0,0,4"/>
                <PasswordBox Name="ApplicationKeyBox" Padding="6" Margin="0,0,0,10"/>
                <TextBlock Text="API Key" Margin="0,0,0,4"/>
                <PasswordBox Name="ApiKeyBox" Padding="6" Margin="0,0,0,10"/>
                <TextBlock Text="Interval načítania (sekundy, 30–3600)" Margin="0,0,0,4"/>
                <TextBox Name="RefreshSecondsBox" Padding="6" Margin="0,0,0,12"/>
                <TextBlock TextWrapping="Wrap" Foreground="#FFB5C5D2"
                           FontSize="11" Margin="0,0,0,16"
                           Text="API kľúče sa ukladajú oddelene, chránené Windows DPAPI pre aktuálne konto. Zatiaľ funguje Cloud API; Local a Auto pribudnú v ďalšej fáze."/>
                <TextBlock Text="Názvy senzorov" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Name="AliasPanel" Margin="0,0,0,12"/>
                <TextBlock TextWrapping="Wrap" Foreground="#FFB5C5D2"
                           FontSize="11"
                           Text="Prázdny názov použije označenie CH1, CH2 atď. Widgety rovnakej stanice zdieľajú jedno načítanie API."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
