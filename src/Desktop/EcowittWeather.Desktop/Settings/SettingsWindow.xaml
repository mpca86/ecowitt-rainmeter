<Window x:Class="EcowittWeather.Desktop.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecowitt Weather – Nastavenia"
        Icon="pack://application:,,,/Assets/EcowittWeather.ico"
        Width="575" Height="760" MinWidth="490" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#FF141D2A"
        Foreground="#FFF5F8FC" FontFamily="Segoe UI">
    <DockPanel Margin="20" LastChildFill="True">
        <!-- Header remains visible when settings scroll -->
        <Border DockPanel.Dock="Top" BorderBrush="#FF425A74"
                BorderThickness="0,0,0,1" Padding="0,0,0,13" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ECOWITT WEATHER" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Desktop Edition · Nastavenia stanice"
                           Foreground="#FFBDCCDA" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action buttons remain visible when settings scroll -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#FF425A74"
                BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Kľúče sú uložené bezpečne v tomto počítači."
                           Foreground="#FFC6D5E2" FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Zrušiť" Width="100" Click="CancelClick"/>
                    <Button Content="Uložiť" Width="112" IsDefault="True"
                            Style="{StaticResource PrimaryActionButton}"
                            Click="SaveClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,5">
                <TextBlock Text="STANICE A PROFILY" FontSize="14" FontWeight="Bold"
                           Foreground="#FF86CFED" Margin="0,0,0,9"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="ProfileCombo" MinHeight="35" VerticalAlignment="Center"
                              Background="#FFF1F5FA" Foreground="#FF162B3C"
                              BorderBrush="#FF89A5BF"
                              SelectionChanged="ProfileSelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="#FF162B3C"/>
                                <Setter Property="Background" Value="#FFF1F5FA"/>
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#FFD8E8F6"/>
                                        <Setter Property="Foreground" Value="#FF162B3C"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFC4E0F2"/>
                                        <Setter Property="Foreground" Value="#FF162B3C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#FF192B3C"
                                           FontSize="13" Margin="5,3"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="+ Pridať" Click="AddProfileClick"/>
                    <Button Grid.Column="2" Content="Odstrániť" Click="RemoveProfileClick"/>
                </Grid>
                <TextBlock Text="Každý widget si môže vybrať vlastnú stanicu. Kľúče Cloud API sú spoločné pre účet."
                           TextWrapping="Wrap" Foreground="#FFBDCCDA"
                           FontSize="12" Margin="0,0,0,16"/>
                <TextBlock Text="CLOUD API" FontSize="14" FontWeight="Bold"
                           Foreground="#FF86CFED" Margin="0,0,0,12"/>
                <TextBlock Text="Application Key" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox Name="ApplicationKeyBox" Margin="0,0,0,12"/>
                <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox Name="ApiKeyBox" Margin="0,0,0,16"/>

                <Border Background="#FF1E2B3A" CornerRadius="7"
                        BorderBrush="#FF465F79" BorderThickness="1"
                        Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="VÝBER STANICE" FontSize="13"
                                   FontWeight="Bold" Margin="0,0,0,7"/>
                        <TextBlock Text="Môžeš načítať stanice priradené k týmto API kľúčom."
                                   TextWrapping="Wrap" Foreground="#FFBDCCDA"
                                   FontSize="12" Margin="0,0,0,9"/>
                        <Button Name="LoadDevicesButton"
                                Content="Načítať stanice z Ecowitt"
                                HorizontalAlignment="Left" Margin="0,0,0,9"
                                Click="LoadDevicesClick"/>
                        <ComboBox Name="StationCombo" MinHeight="37"
                                  Background="#FFF1F5FA" Foreground="#FF13263A"
                                  BorderBrush="#FF89A5BF" FontSize="12"
                                  IsEnabled="False" Margin="0,0,0,8"
                                  SelectionChanged="DeviceSelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#FF162B3C"/>
                                    <Setter Property="Background" Value="#FFF1F5FA"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#FFD8E8F6"/>
                                            <Setter Property="Foreground" Value="#FF162B3C"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFC4E0F2"/>
                                            <Setter Property="Foreground" Value="#FF162B3C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Foreground="#FF162B3C"
                                               FontSize="12" Margin="5,3"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Name="DeviceStatus" Text="Zoznam sa načíta po kliknutí."
                                   Foreground="#FFD1DCE7" TextWrapping="Wrap"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Názov profilu" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Name="ProfileNameBox" Margin="0,0,0,12" LostFocus="ProfileNameLostFocus"/>
                <TextBlock Text="MAC adresa stanice" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Name="MacBox" Margin="0,0,0,4"/>
                <TextBlock Text="MAC možno zadať aj ručne (AA:BB:CC:DD:EE:FF)."
                           Foreground="#FFBDCCDA" FontSize="11" Margin="0,0,0,14"/>

                <TextBlock Text="Interval načítania (30–3600 sekúnd)"
                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Name="RefreshSecondsBox" Width="125"
                         HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <Border BorderBrush="#FF425A74" BorderThickness="0,1,0,0"
                        Margin="0,0,0,15"/>
                <TextBlock Text="NÁZVY SENZOROV CH1–CH8"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#FF86CFED" Margin="0,0,0,7"/>
                <TextBlock Text="Prázdne pole použije názov CH1, CH2 a podobne."
                           Foreground="#FFBDCCDA" FontSize="12"
                           Margin="0,0,0,12"/>
                <StackPanel Name="AliasPanel" Margin="0,0,0,12"/>
                <TextBlock TextWrapping="Wrap" Foreground="#FFB9CADA"
                           FontSize="11"
                           Text="Cloud API pre všetky stanice z jedného účtu. Dopyty na rovnakú stanicu sa zdieľajú medzi widgetmi."/>
                <Button Content="O programe" HorizontalAlignment="Left"
                        Margin="0,18,0,4" Click="AboutClick"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
