<Window x:Class="EcowittWeather.Desktop.Widgets.WeatherWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecowitt Weather Desktop"
        Icon="pack://application:,,,/Assets/EcowittWeather.ico"
        Width="286" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False"
        WindowStartupLocation="Manual">
    <Border Background="#EB151B25" BorderBrush="#50667987"
            BorderThickness="1" CornerRadius="9" Padding="14"
            MouseLeftButtonDown="DragWidget" MouseRightButtonUp="ShowWidgetMenu" ToolTip="Ľavé potiahnutie: presun · pravý klik: ponuka">
        <StackPanel>
            <TextBlock Text="{Binding StationName}" FontWeight="SemiBold"
                       FontSize="13" HorizontalAlignment="Left" Margin="2,0,0,12"
                       MaxWidth="250" TextTrimming="CharacterEllipsis"/>
            <Border BorderBrush="#47637A8D" BorderThickness="0,0,0,1"
                    Margin="0,0,0,9"/>
            <Grid Margin="0,2,0,9">
                <TextBlock Text="Vonku" Foreground="#B8C5D1" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Outdoor}" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="  " />
                    <TextBlock Text="{Binding OutdoorHumidity}" FontSize="13"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,2,0,6">
                <TextBlock Text="Interiér" Foreground="#B8C5D1"/>
                <TextBlock Text="{Binding Indoor}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2,0,6">
                <TextBlock Text="Vietor / nárazy" Foreground="#B8C5D1"/>
                <TextBlock Text="{Binding Wind}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2,0,6">
                <TextBlock Text="Tlak" Foreground="#B8C5D1"/>
                <TextBlock Text="{Binding Pressure}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2,0,6">
                <TextBlock Text="Zrážky" Foreground="#B8C5D1"/>
                <TextBlock Text="{Binding Rain}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2,0,6">
                <TextBlock Text="UV" Foreground="#B8C5D1"/>
                <TextBlock Text="{Binding Uv}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2,0,10">
                <TextBlock Text="Solárne žiarenie" Foreground="#B8C5D1"/>
                <TextBlock Text="{Binding Solar}" HorizontalAlignment="Right"/>
            </Grid>
            <Border BorderBrush="#47637A8D" BorderThickness="0,1,0,0"
                    Margin="0,0,0,7"/>
            <ItemsControl ItemsSource="{Binding Sensors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <TextBlock Text="{Binding Name}" Foreground="#B8C5D1"
                                       MaxWidth="120" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="#47637A8D" BorderThickness="0,1,0,0"
                    Margin="0,9,0,6"/>
            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#E7C778"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Updated}" FontSize="10" Foreground="#9CB0BD"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>
