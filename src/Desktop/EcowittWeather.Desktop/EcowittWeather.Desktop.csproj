<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EcowittWeather.Desktop</AssemblyName>
    <Version>0.2.0-alpha.1</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>Ecowitt Weather Desktop Edition</Product>
    <Title>Ecowitt Weather Desktop</Title>
    <Authors>Martin Šturcel (mpca86)</Authors>
    <Company>mpca86</Company>
    <Description>Desktopové widgety meteorologických staníc Ecowitt s Web API a podporou viacerých staníc.</Description>
    <Copyright>© 2026 Martin Šturcel</Copyright>
    <PackageLicenseExpression>CC-BY-NC-SA-3.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mpca86/ecowitt-rainmeter</RepositoryUrl>
    <ApplicationIcon>Assets\EcowittWeather.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EcowittWeather.Core\EcowittWeather.Core.csproj" />
    <ProjectReference Include="..\EcowittWeather.Infrastructure\EcowittWeather.Infrastructure.csproj" />
    <Resource Include="Assets\EcowittWeather.ico"/>
    <EmbeddedResource Include="Assets\EcowittWeather.ico" LogicalName="EcowittWeather.Icon"/>
    <EmbeddedResource Include="Assets\UpdateHelper.ps1" LogicalName="EcowittWeather.UpdateHelper"/>
  </ItemGroup>
</Project>
